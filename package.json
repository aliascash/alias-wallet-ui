{
  "name": "alias-wallet-desktop",
  "version": "5.1.0",
  "description": "ALIAS wallet desktop UI — Electron front-end for the aliaswalletd daemon. Mirrors the original ALIAS UI (HTML/CSS/JS from aliascash/alias-wallet-ui) without Qt.",
  "main": "src/main/main.js",
  "author": "ALIAS Developers",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "cash.alias.wallet",
    "productName": "ALIAS",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "!**/*.md"
    ],
    "extraResources": [
      {
        "from": "resources/${platform}/${arch}",
        "to": "daemon",
        "filter": [
          "aliaswalletd",
          "aliaswalletd.exe",
          "Tor/**/*"
        ]
      }
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Finance",
      "maintainer": "ALIAS Developers <dev@alias.cash>"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "perMachine": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ALIAS",
      "uninstallDisplayName": "ALIAS Wallet ${version}",
      "license": "build/license.txt",
      "include": "build/installer.nsh",
      "installerLanguages": ["en_US", "de_DE", "es_ES", "fr_FR", "it_IT", "tr_TR", "ru_RU"],
      "displayLanguageSelector": true,
      "multiLanguageInstaller": true
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.finance"
    }
  }
}
